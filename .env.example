# Copy to .env and fill in. Never commit .env.
DATABASE_URL=postgres://localhost:5432/your_database

# Owner sign-in (one owner). Make the hash with:  npm run owner:hash -- "your password"
OWNER_EMAIL=owner@example.com
OWNER_PASSWORD_HASH=scrypt:...

# Deployed stores (Vercel): connect Vercel Blob so photo uploads work. Without it a deployed build refuses to start.
# BLOB_READ_WRITE_TOKEN=
# DEPLOYED=1   (set automatically on Vercel via VERCEL=1)

# Playwright checks only: the plain password for OWNER_PASSWORD_HASH above.
# E2E_OWNER_PASSWORD=
